# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# PBKDF2 Secret Salt (at least 32 characters long)
SECRET_SALT="your-secure-secret-salt-min-32-chars-here"

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://verification-dmu.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Vercel Cron Secret (for /api/keep-alive)
CRON_SECRET="your-random-cron-secret-token-here"

# Port for local server (optional, defaults to 3000)
PORT=3000
